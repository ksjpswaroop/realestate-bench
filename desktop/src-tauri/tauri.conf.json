{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealEstate-Bench",
  "version": "0.1.0",
  "identifier": "com.ksjpswaroop.realestate-bench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RealEstate-Bench",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../sidecar/realestate_extract/schemas.py",
      "../sidecar/realestate_extract/__init__.py",
      "../sidecar/realestate_extract/cli.py",
      "../schemas/lease_addendum.json",
      "../schemas/invoice.json",
      "../schemas/rent_roll.json",
      "../schemas/medical_soap_note.json"
    ],
    "externalBin": [
      "bin/realestate-extract"
    ],
    "category": "Productivity",
    "shortDescription": "Local document-AI extraction for real estate",
    "longDescription": "Drag-and-drop lease addenda, invoices, and rent rolls; extract structured data on-device with cactus-needle; export to Excel, JSON, CSV, and SQLite.",
    "homepage": "https://github.com/ksjpswaroop/realestate-bench"
  }
}
